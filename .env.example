# Keep SearXNG bound to localhost unless you intentionally want LAN access.
SEARXNG_HOST=127.0.0.1
SEARXNG_PORT=8080

# Use a release tag instead of latest if you need reproducible upgrades.
SEARXNG_VERSION=latest

# setup.sh replaces this with a random value when it creates .env.
SEARXNG_SECRET=replace-me-with-a-long-random-secret

# Used by SearXNG for optional rate limiting and other stateful features.
SEARXNG_VALKEY_URL=valkey://valkey:6379/0
